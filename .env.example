# Image version tag
VERSION=2.3.0
# Image and container name (compose, Makefile, composeup)
CONTAINER_NAME=autostream
# Networking mode. Keep exactly one COMPOSE_FILE line active:
#   host:    MediaMTX and the API bind this host's ports directly. For a
#            publisher on its own host; the host firewall applies.
#   octo-cx: join the consumer's octo-cx-network and publish the ports one to
#            one. For a publisher on the same host as the consumer stack.
COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.octo-cx.yml
# RTSP listener port
MEDIAMTX_RTSP_PORT=8554
# RTP UDP port
MEDIAMTX_RTP_PORT=8000
# RTCP UDP port
MEDIAMTX_RTCP_PORT=8001
# HLS HTTP port
MEDIAMTX_HLS_PORT=8888
# Stream supervisor UI/API port
STREAM_API_PORT=8080
# Supervisor log level: debug, info, warning, or error.
# debug also surfaces ffmpeg output from the stream processes.
LOG_LEVEL=info
# Where the KLV feeds go, the UDP port range, the advertised host, and the
# bitrate cap are set in the web UI under Settings and saved with the state.
